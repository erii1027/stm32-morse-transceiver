}

/* ===================== TIM6 初始化 ===================== */

static void TIM6_Init(void)
{
    /*
     * HSI = 16 MHz
     * APB1 prescaler = 1
     * TIM6CLK = 16 MHz
     *
     * Counter frequency = 16 MHz / (15 + 1)
     *                   = 1 MHz
     *
     * Update frequency = 1 MHz / (999 + 1)
     *                   = 1 kHz = 1 ms
     */
    htim6.Instance = TIM6;
    htim6.Init.Prescaler = 15U;
    htim6.Init.CounterMode = TIM_COUNTERMODE_UP;
    htim6.Init.Period = 999U;
    htim6.Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_DISABLE;

    if (HAL_TIM_Base_Init(&htim6) != HAL_OK)
    {
        Error_Handler();
    }
}

/* ===================== UART / TIM MSP 初始化 ===================== */

void HAL_UART_MspInit(UART_HandleTypeDef *huart)
{
    GPIO_InitTypeDef gpio = {0};

    if (huart->Instance == LPUART1)
    {
        __HAL_RCC_LPUART1_CLK_ENABLE();
        __HAL_RCC_GPIOA_CLK_ENABLE();

        /* PA2 = LPUART1_TX, PA3 = LPUART1_RX, AF12 */
        gpio.Pin = GPIO_PIN_2 | GPIO_PIN_3;
        gpio.Mode = GPIO_MODE_AF_PP;
        gpio.Pull = GPIO_PULLUP;
        gpio.Speed = GPIO_SPEED_FREQ_VERY_HIGH;
        gpio.Alternate = GPIO_AF12_LPUART1;
        HAL_GPIO_Init(GPIOA, &gpio);

        HAL_NVIC_SetPriority(LPUART1_IRQn, 3, 0);
        HAL_NVIC_EnableIRQ(LPUART1_IRQn);
    }
}

void HAL_TIM_Base_MspInit(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM6)
    {
        __HAL_RCC_TIM6_CLK_ENABLE();

        HAL_NVIC_SetPriority(TIM6_DAC_IRQn, 1, 0);
        HAL_NVIC_EnableIRQ(TIM6_DAC_IRQn);
    }
}

