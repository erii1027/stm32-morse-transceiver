/* ===================== 毫秒計時 ===================== */

static uint32_t Morse_GetMillis(void)
{
    return msTicks;
}

static bool TimeElapsed(uint32_t now,
                        uint32_t start,
                        uint32_t duration)
{
    return ((uint32_t)(now - start) >= duration);
}

/* ===================== UART 輸出 ===================== */

static void UART_Print(const char *text)
{
    if (text == NULL)
    {
        return;
    }

    (void)HAL_UART_Transmit(&hlpuart1,
                            (uint8_t *)text,
                            (uint16_t)strlen(text),
                            1000U);
}

static void UART_Printf(const char *format, ...)
{
    char buffer[256];
    va_list args;

    va_start(args, format);
    int len = vsnprintf(buffer, sizeof(buffer), format, args);
    va_end(args);

    if (len <= 0)
    {
        return;
    }

    if (len >= (int)sizeof(buffer))
    {
        len = (int)sizeof(buffer) - 1;
    }

    (void)HAL_UART_Transmit(&hlpuart1,
                            (uint8_t *)buffer,
                            (uint16_t)len,
                            1000U);
}

/* ===================== UART 中斷接收 ===================== */

static void UART_StartReceive(void)
{
    if (HAL_UART_Receive_IT(&hlpuart1, &uartRxByte, 1U) != HAL_OK)
    {
        UART_Print("ERROR: UART RX start failed.\r\n");
    }
}

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance != LPUART1)
    {
        return;
    }

    char c = (char)uartRxByte;

    if (uartLineReady == 0U)
    {
        if (c == '\r' || c == '\n')
        {
            if (uartRxIndex > 0U || uartLineOverflow != 0U)
            {
                if (uartRxIndex < UART_LINE_SIZE)
                {
                    uartRxLine[uartRxIndex] = '\0';
                }

                uartLineReady = 1U;
            }
        }
        else if (c == '\b' || c == 127)
        {
            if (uartRxIndex > 0U && uartLineOverflow == 0U)
            {
                uartRxIndex--;
                uartRxLine[uartRxIndex] = '\0';
            }
        }
        else if ((uint8_t)c >= 32U && (uint8_t)c <= 126U)
        {
            if (uartLineOverflow == 0U)
            {
                if (uartRxIndex < UART_LINE_SIZE - 1U)
                {
                    uartRxLine[uartRxIndex++] = c;
                    uartRxLine[uartRxIndex] = '\0';
                }
                else
                {
                    uartLineOverflow = 1U;
                }
            }
        }
    }

    /* Continue receiving the next byte. */
    (void)HAL_UART_Receive_IT(&hlpuart1, &uartRxByte, 1U);
}

void HAL_UART_ErrorCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance != LPUART1)
    {
        return;
    }

    (void)HAL_UART_AbortReceive(huart);
    (void)HAL_UART_Receive_IT(huart, &uartRxByte, 1U);
}

/* ===================== 摩斯編碼及解碼 ===================== */

static const char *Morse_Encode(char c)
{
    c = (char)toupper((unsigned char)c);

    for (size_t i = 0U; i < MORSE_TABLE_COUNT; i++)
    {
        if (morseTable[i].character == c)
        {
            return morseTable[i].code;
        }
    }

    return NULL;
}

static char Morse_Decode(const char *code)
{
    if (code == NULL || code[0] == '\0')
    {
        return '?';
    }

    for (size_t i = 0U; i < MORSE_TABLE_COUNT; i++)
    {
        if (strcmp(morseTable[i].code, code) == 0)
        {
            return morseTable[i].character;
        }
    }

    return '?';
}

/* ===================== 訊息緩衝區 ===================== */

static void Morse_AppendMessageChar(char c)
{
    if (messageLen >= MESSAGE_SIZE - 1U)
    {
        UART_Print("WARNING: Message buffer full.\r\n");
        return;
    }

    message[messageLen++] = c;
    message[messageLen] = '\0';
}

/* ===================== PC8 摩斯輸入 ===================== */

static void Morse_ProcessKey(void)
{
    uint32_t now = Morse_GetMillis();

    uint8_t rawPressed =
        (HAL_GPIO_ReadPin(KEY_PORT, KEY_PIN) == GPIO_PIN_RESET)
        ? 1U : 0U;

    if (rawPressed != keyCandidatePressed)
    {
        keyCandidatePressed = rawPressed;
        keyCandidateSince = now;
    }

    /* 25 ms stable state = valid button transition. */
    if ((keyCandidatePressed != keyStablePressed) &&
        TimeElapsed(now, keyCandidateSince, DEBOUNCE_MS))
    {
        keyStablePressed = keyCandidatePressed;

        if (keyStablePressed != 0U)
        {
            keyPressStart = now;
        }
        else
        {
            uint32_t duration = now - keyPressStart;

            if (currentMorseLen < MAX_MORSE_LEN)
            {
                char symbol = (duration < 250U) ? '.' : '-';

                currentMorse[currentMorseLen++] = symbol;
                currentMorse[currentMorseLen] = '\0';

                UART_Printf("Symbol: %c, duration=%lu ms, code=%s\r\n",
                            symbol,
                            (unsigned long)duration,
                            currentMorse);
            }
            else
            {
                UART_Print("ERROR: Morse letter too long; cleared.\r\n");
                currentMorseLen = 0U;
                currentMorse[0] = '\0';
            }

            keyReleaseTime = now;
            wordSpaceInserted = 0U;
        }
    }

    /* Letter completion: release for 600 ms. */
    if (keyStablePressed == 0U &&
        currentMorseLen > 0U &&
        TimeElapsed(now, keyReleaseTime, LETTER_TIMEOUT_MS))
    {
        Morse_FinalizeLetter();
    }

    /* Word completion: release for 3000 ms. */
    if (keyStablePressed == 0U &&
        currentMorseLen == 0U &&
        messageLen > 0U &&
        message[messageLen - 1U] != ' ' &&
        wordSpaceInserted == 0U &&
        TimeElapsed(now, keyReleaseTime, WORD_TIMEOUT_MS))
    {
        Morse_InsertWordSpace();
    }
}

static void Morse_FinalizeLetter(void)
{
    char decoded = Morse_Decode(currentMorse);

    UART_Printf("Decoded: %s -> %c\r\n", currentMorse, decoded);

    if (decoded != '?')
    {
        Morse_AppendMessageChar(decoded);
        UART_Printf("Current message: \"%s\"\r\n", message);
    }
    else
    {
        UART_Print("WARNING: Invalid Morse sequence.\r\n");
    }

    currentMorseLen = 0U;
    currentMorse[0] = '\0';
}

static void Morse_InsertWordSpace(void)
{
    if (messageLen == 0U || message[messageLen - 1U] == ' ')
    {
        wordSpaceInserted = 1U;
        return;
    }

    Morse_AppendMessageChar(' ');
    wordSpaceInserted = 1U;

    UART_Printf("Word gap. Current message: \"%s\"\r\n", message);
}

/* ===================== PC9 發送按鈕 ===================== */

static bool Morse_IsBusy(void)
{
    return (playbackActive != 0U) ||
           (keyStablePressed != 0U) ||
           (currentMorseLen > 0U);
}

static void Morse_ProcessSendButton(void)
{
    uint32_t now = Morse_GetMillis();

    uint8_t rawPressed =
        (HAL_GPIO_ReadPin(SEND_PORT, SEND_PIN) == GPIO_PIN_RESET)
        ? 1U : 0U;

    if (rawPressed != sendCandidatePressed)
    {
        sendCandidatePressed = rawPressed;
        sendCandidateSince = now;
    }

    if ((sendCandidatePressed != sendStablePressed) &&
        TimeElapsed(now, sendCandidateSince, DEBOUNCE_MS))
    {
        sendStablePressed = sendCandidatePressed;

        /* Trigger only once when the debounced press begins. */
        if (sendStablePressed != 0U)
        {
            sendExtiFlag = 0U;

            if (Morse_IsBusy())
            {
                UART_Print("BUSY: Finish input/playback first.\r\n");
            }
            else if (messageLen == 0U)
            {
                UART_Print("ERROR: Message is empty.\r\n");
            }
            else
            {
                UART_Printf("Sending: \"%s\"\r\n", message);
                Morse_StartPlayback(message);
            }
        }
    }
}

/* ===================== LED 播放事件 ===================== */

static bool Morse_AddPlayEvent(uint8_t ledOn, uint16_t durationMs)
{
    if (playEventCount >= MAX_PLAY_EVENTS)
    {
        return false;
    }

    playEvents[playEventCount].ledOn = ledOn;
    playEvents[playEventCount].durationMs = durationMs;
    playEventCount++;

    return true;
}

static bool Morse_BuildPlayback(const char *text)
{
    if (text == NULL || text[0] == '\0')
    {
        return false;
    }

    playEventCount = 0U;

    for (size_t i = 0U; text[i] != '\0'; i++)
    {
        char c = (char)toupper((unsigned char)text[i]);

        if (c == ' ')
        {
            continue;
        }

        const char *code = Morse_Encode(c);

        if (code == NULL)
        {
            continue;
        }

        for (size_t j = 0U; code[j] != '\0'; j++)
        {
            uint16_t onTime =
                (code[j] == '.') ? DOT_MS : DASH_MS;

            if (!Morse_AddPlayEvent(1U, onTime))
            {
                return false;
            }

            if (code[j + 1U] != '\0')
            {
                if (!Morse_AddPlayEvent(0U, SYMBOL_GAP_MS))
                {
                    return false;
                }
            }
        }

        /* Gap after the letter: word gap or letter gap. */
        if (text[i + 1U] != '\0')
        {
            size_t next = i + 1U;
            uint16_t gap;

            if (text[next] == ' ')
            {
                gap = WORD_GAP_MS;

                while (text[next] == ' ')
                {
                    next++;
                }

                i = next - 1U;
            }
            else
            {
                gap = LETTER_GAP_MS;
            }

            if (!Morse_AddPlayEvent(0U, gap))
            {
                return false;
            }
        }
    }

    return (playEventCount > 0U);
}

static void Morse_StartPlayback(const char *text)
{
    if (playbackActive != 0U)
    {
        UART_Print("BUSY: Playback already active.\r\n");
        return;
    }

    if (!Morse_BuildPlayback(text))
    {
        UART_Print("ERROR: No valid Morse playback sequence.\r\n");
        return;
    }

    playEventIndex = 0U;
    playbackActive = 1U;
    playEventStart = Morse_GetMillis();

    HAL_GPIO_WritePin(LED_PORT, LED_PIN,
                      playEvents[0].ledOn
                      ? GPIO_PIN_SET : GPIO_PIN_RESET);

    UART_Print("Playback started.\r\n");
}

static void Morse_UpdatePlayback(void)
{
    if (playbackActive == 0U)
    {
        return;
    }

    uint32_t now = Morse_GetMillis();

    if (!TimeElapsed(now,
                     playEventStart,
                     playEvents[playEventIndex].durationMs))
    {
        return;
    }

    playEventIndex++;

    if (playEventIndex >= playEventCount)
    {
        Morse_StopPlayback();
        return;
    }

    playEventStart = now;

    HAL_GPIO_WritePin(LED_PORT, LED_PIN,
                      playEvents[playEventIndex].ledOn
                      ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

static void Morse_StopPlayback(void)
{
    playbackActive = 0U;
    playEventCount = 0U;
    playEventIndex = 0U;

    HAL_GPIO_WritePin(LED_PORT, LED_PIN, GPIO_PIN_RESET);
    UART_Print("Playback complete.\r\n");
}

/* ===================== UART 完整行處理 ===================== */

static void Morse_HandleUARTLine(void)
{
    if (uartLineReady == 0U)
    {
        return;
    }

    char localLine[UART_LINE_SIZE];
    uint8_t overflow;

    /*
     * Protect shared UART line while copying.
     * The UART RX interrupt may run again after interrupts resume.
     */
    uint32_t primask = __get_PRIMASK();
    __disable_irq();

    memcpy(localLine, uartRxLine, sizeof(localLine));
    localLine[sizeof(localLine) - 1U] = '\0';

    overflow = uartLineOverflow;

    uartRxIndex = 0U;
    uartLineReady = 0U;
    uartLineOverflow = 0U;
    uartRxLine[0] = '\0';

    if (primask == 0U)
    {
        __enable_irq();
    }

    if (overflow != 0U)
    {
        UART_Print("ERROR: UART line too long; discarded.\r\n");
        return;
    }

    char normalized[UART_LINE_SIZE];
    size_t out = 0U;
    uint8_t lastSpace = 1U;

    for (size_t i = 0U; localLine[i] != '\0'; i++)
    {
        unsigned char c = (unsigned char)localLine[i];

        if (isalpha(c) || isdigit(c))
        {
            if (out < sizeof(normalized) - 1U)
            {
                normalized[out++] = (char)toupper(c);
                lastSpace = 0U;
            }
        }
        else if (c == ' ' && lastSpace == 0U)
        {
            if (out < sizeof(normalized) - 1U)
            {
                normalized[out++] = ' ';
                lastSpace = 1U;
            }
        }
    }

    while (out > 0U && normalized[out - 1U] == ' ')
    {
        out--;
    }

    normalized[out] = '\0';

    if (normalized[0] == '\0')
    {
        UART_Print("ERROR: Enter letters/digits, then press Enter.\r\n");
        return;
    }

    if (Morse_IsBusy())
    {
        UART_Print("BUSY: Input received but system is busy; ignored.\r\n");
        return;
    }

    UART_Printf("UART received: \"%s\"\r\n", normalized);
    Morse_StartPlayback(normalized);
}

/* ===================== 主迴圈處理 ===================== */

static void Morse_Process(void)
{
    Morse_ProcessKey();
    Morse_ProcessSendButton();
    Morse_HandleUARTLine();
    Morse_UpdatePlayback();
}

/* ===================== HAL 中斷回呼 ===================== */

void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == KEY_PIN)
    {
        keyExtiFlag = 1U;
    }
    else if (GPIO_Pin == SEND_PIN)
    {
        sendExtiFlag = 1U;
    }
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM6)
    {
        msTicks++;
    }
}

/* ===================== 錯誤處理 ===================== */

void Error_Handler(void)
{
    __disable_irq();

    while (1)
    {
        /* Stop here if initialization fails. */
    }
}
