/* LED 播放事件 */
static uint16_t         ev[EV_MAX];
static uint16_t         ev_n, ev_i;
static uint32_t         ev_next;
static volatile uint8_t playing;

/* ---------- 工具函式 ---------- */
static void uart_print(const char *s)
{
    HAL_UART_Transmit(&hlpuart1, (uint8_t *)s, (uint16_t)strlen(s), 100);
}

static void led_set(int on)
{
    HAL_GPIO_WritePin(LED_PORT, LED_PIN, on ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

static void Player_Start(const char *s)
{
    ev_n = 0;
    for (; *s && (ev_n + 12) < EV_MAX; s++) {
        char c = (char)toupper((unsigned char)*s);
        if (c == ' ') {
            if (ev_n > 0) ev[ev_n - 1] = 7 * UNIT_MS;
            continue;
        }
        const char *code = code_of(c);
        if (!code) continue;
        for (; *code; code++) {
            ev[ev_n++] = (*code == '.') ? UNIT_MS : 3 * UNIT_MS;
            ev[ev_n++] = UNIT_MS;
        }
        ev[ev_n - 1] = 3 * UNIT_MS;
    }
    if (ev_n == 0) return;
    ev_i = 0;
    playing = 1;
    led_set(1);
    ev_next = ms_tick + ev[0];
}

static void Player_Update(void)
{
    if (!playing) return;
    if ((int32_t)(ms_tick - ev_next) < 0) return;

    ev_i++;
    if (ev_i >= ev_n) {
        led_set(0);
        playing = 0;
        uart_print("[LED] done\r\n");
        return;
    }
    led_set((ev_i % 2) == 0);
    ev_next += ev[ev_i];
}

/* ---------- 初始化 ---------- */
void Morse_Init(void)
{
    led_set(0);
    HAL_TIM_Base_Start_IT(&htim6);
    HAL_UART_Receive_IT(&hlpuart1, &rx_byte, 1);
    uart_print("\r\n=== Morse transceiver ready ===\r\n");
    uart_print("PC8: key (short=. long=-)  PC9: send  | type text + Enter to blink it\r\n");
}

