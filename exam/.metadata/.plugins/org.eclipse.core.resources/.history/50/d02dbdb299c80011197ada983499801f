#define LED_PORT        GPIOC
#define LED_PIN         GPIO_PIN_6
#define KEY_PIN         GPIO_PIN_8      /* PC8 摩斯按鍵 */
#define SEND_PIN        GPIO_PIN_9      /* PC9 發送按鈕 */

/* ---------- 測試用全域計數器與標誌 ---------- */
static volatile uint32_t ms_tick = 0;
static volatile uint32_t exti8_cnt = 0;
static volatile uint32_t exti9_cnt = 0;

static volatile uint8_t  key_press_event = 0;
static volatile uint8_t  key_release_event = 0;
static volatile uint8_t  send_press_event = 0;

static volatile uint32_t press_start_tick = 0;
static volatile uint32_t last_duration = 0;

/* ---------- 格式化字串輸出 ---------- */
static void uart_print(const char *s)
{
    HAL_UART_Transmit(&hlpuart1, (uint8_t *)s, (uint16_t)strlen(s), 100);
}

static void led_set(int on)
{
    HAL_GPIO_WritePin(LED_PORT, LED_PIN, on ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

/* ---------- 測試初始化 ---------- */
void Morse_Init(void)
{
    led_set(0);
    HAL_TIM_Base_Start_IT(&htim6);
    uart_print("\r\n========================================\r\n");
    uart_print("      STM32 GPIO / EXTI Test Mode       \r\n");
    uart_print("========================================\r\n");
    uart_print("Press PC8 (KEY) or PC9 (SEND) to test...\r\n\r\n");
}

/* ---------- 測試主處理迴圈 ---------- */
void Morse_Process(void)
{
    char buf[128];

    /* 處理 PC8 按下事件 */
    if (key_press_event) {
        key_press_event = 0;
        snprintf(buf, sizeof(buf), "[PC8 KEY] Pressed DOWN (Total EXTI: %lu)\r\n", exti8_cnt);
        uart_print(buf);
    }

    /* 處理 PC8 放開事件 */
    if (key_release_event) {
        key_release_event = 0;
        snprintf(buf, sizeof(buf), "[PC8 KEY] Released UP   | Duration: %lu ms\r\n", last_duration);
        uart_print(buf);
    }

    /* 處理 PC9 按下事件 */
    if (send_press_event) {
        send_press_event = 0;
        snprintf(buf, sizeof(buf), "[PC9 SEND] Pressed DOWN  (Total EXTI: %lu)\r\n", exti9_cnt);
        uart_print(buf);
    }
}

/* ---------- EXTI 與 TIM 回呼函式 ---------- */

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM6) {
        ms_tick++;
    }
}

/* 下降緣 = 按下 (Pull-up 下拉至 GND) */
void HAL_GPIO_EXTI_Falling_Callback(uint16_t GPIO_Pin)
{
    uint32_t now = ms_tick;

    if (GPIO_Pin == KEY_PIN) {
        exti8_cnt++;
        press_start_tick = now;
        key_press_event = 1;
        led_set(1); /* LED 亮起 */
    }
    else if (GPIO_Pin == SEND_PIN) {
        exti9_cnt++;
        send_press_event = 1;
    }
}

/* 上升緣 = 放開 */
void HAL_GPIO_EXTI_Rising_Callback(uint16_t GPIO_Pin)
{
    uint32_t now = ms_tick;

    if (GPIO_Pin == KEY_PIN) {
        exti8_cnt++;
        last_duration = now - press_start_tick;
        key_release_event = 1;
        led_set(0); /* LED 熄滅 */
    }
}

